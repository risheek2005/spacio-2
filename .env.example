# ─────────────────────────────────────────────────────────────────────────────
# SPACIO Campus Assistant — Environment Variables
#
# Copy this file to .env and fill in your values.
# .env is git-ignored. Never commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# Google Gemini API key — https://aistudio.google.com/app/apikey
# Required for the AI Campus Assistant chatbot feature.
# Secure server-side variable (recommended):
GEMINI_API_KEY=your_gemini_api_key_here

# Legacy Vite client variable (optional fallback for development):
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Model to use (optional — defaults to gemini-3.5-flash-lite / gemini-3.5-flash)
# GEMINI_MODEL=gemini-3.5-flash-lite
